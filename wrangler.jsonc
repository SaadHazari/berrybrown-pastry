{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berrybrown-pastry",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API goes through the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public. The secret key is NOT here — see the secrets below.
    "SUPABASE_URL": "https://ylrqmwfnelwqbychdpfb.supabase.co"
  },
  "observability": { "enabled": true }
  // Secrets (set once each, or in the dashboard under Settings → Variables and Secrets):
  //   npx wrangler secret put STRIPE_SECRET_KEY        sk_live_… (use sk_test_… first)
  //   npx wrangler secret put STRIPE_WEBHOOK_SECRET    whsec_… from the Stripe webhook for https://berrybrown.me/api/stripe/webhook
  //   npx wrangler secret put SUPABASE_SECRET_KEY      sb_secret_… from Supabase → Project Settings → API keys
}
