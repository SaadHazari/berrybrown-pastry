{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berrybrown-pastry",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API goes through the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public. Every Berry Brown variable is BB_-prefixed so a Dormers key can never be used by accident.
    "BB_SUPABASE_URL": "https://ylrqmwfnelwqbychdpfb.supabase.co"
  },
  "observability": { "enabled": true }
  // Secrets (set once each, or in the dashboard under Settings → Variables and Secrets):
  //   npx wrangler secret put BB_SUPABASE_SECRET_KEY        sb_secret_… from Supabase → Project Settings → API keys
  //   npx wrangler secret put BB_STRIPE_SECRET_KEY          the Dormers account key: sk_test_… first, sk_live_… later
  //   npx wrangler secret put BB_STRIPE_WEBHOOK_SECRET      whsec_… from the Stripe webhook for https://berrybrown.me/api/stripe/webhook
  //   npx wrangler secret put BB_STRIPE_DESCRIPTOR_SUFFIX   optional, e.g. "BERRY BROWN" — Dormers prefix + suffix must fit 22 characters
}
